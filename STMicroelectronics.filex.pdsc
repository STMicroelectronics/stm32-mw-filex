<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:stm32="https://developer.st.com/schemas/stm32cube/1.0.0" schemaVersion="1.7.55" xsi:noNamespaceSchemaLocation="PACK.xsd" xsi:schemaLocation="https://developer.st.com/schemas/stm32cube/1.0.0 stm32cube.xsd" Dvendor="STMicroelectronics:13" Dname="STM32*">
  <vendor>STMicroelectronics</vendor>
  <name>filex</name>
  <environments>
    <environment name="STM32Cube">
      <stm32:pack type="MW" friendlyName="filex" shortDesc="FileX Middleware">
        <relocation-info parent="middleware" layer="" element=""/>
      </stm32:pack>
    </environment>
  </environments>
  <ECCN>
    <ECCN-EU>NEC</ECCN-EU>
    <ECCN-US>EAR99</ECCN-US>
  </ECCN>
  <description>STMicroelectronics filex pack</description>
  <repository type="git">https://github.com/STMicroelectronics/stm32-mw-filex/tree/hal2</repository>
  <url>https://developer.st.com/st-pack-server/api/v1/pack/</url>
  <license>LICENSE.md</license>
  <releases>
    <release date="2026-03-06" version="2.0.0">
      Official release of FileX Middleware based on FileX v6.4.2.
      ## Main changes
        * Official release of FileX aligned with HAL2.
        * Supported interfaces: NOR and NAND flash, along with SD and MMC storage devices.
    </release>
  </releases>
  <changelogs>
    <changelog id="Release Notes" name="ST_Release_Notes.html"/>
  </changelogs>
  <keywords>
    <keyword>Cortex-M</keyword>
    <keyword>STMicroelectronics</keyword>
    <keyword>FileX</keyword>
    <keyword>STM32</keyword>
  </keywords>
  <conditions>
    <condition id="USE FAULT TOLERANCE ENV">
    </condition>
    <condition id="USE SD DMA OS ENV">
    </condition>
    <condition id="USE SD DMA NO OS ENV">
    </condition>
    <condition id="USE SD POLLING ENV">
    </condition>
    <condition id="USE MMC DMA OS ENV">
    </condition>
    <condition id="USE MMC DMA NO OS ENV">
    </condition>
    <condition id="USE MMC POLLING ENV">
    </condition>
    <condition id="USE NOR ENV">
    </condition>
    <condition id="USE NAND ENV">
    </condition>
    <condition id="filex standalone condition">
      <require Cclass="File System" Cgroup="FileX" Csub="No_OS"/>
    </condition>
    <condition id="filex freertos condition">
      <deny Cclass="File System" Cgroup="FileX" Csub="No_OS"/>
      <require Cclass="RTOS" Cgroup="FreeRTOS" Csub="Core"/>
    </condition>
    <condition id="Operating System Used">
    </condition>
    <condition id="FX Core Condition">
      <description>FX common condition :dependency to FileX Core</description>
      <require Cclass="File System" Cgroup="FileX" Csub="Core"/>
      <require condition="USE FAULT TOLERANCE ENV"/>
      <require condition="Operating System Used"/>
      <require condition="USE SD DMA OS ENV"/>
      <require condition="USE SD DMA NO OS ENV"/>
      <require condition="USE SD POLLING ENV"/>
      <require condition="USE MMC DMA OS ENV"/>
      <require condition="USE MMC DMA NO OS ENV"/>
      <require condition="USE MMC POLLING ENV"/>
      <require condition="USE NOR ENV"/>
      <require condition="USE NAND ENV"/>
    </condition>
  </conditions>
  <generators>
    <!-- This generator is launched if any component referencing this generator by 'id' is selected and the specified <gpdsc> file does not exist -->
    <generator id="filex_mx2codegen">
      <description>STMicroelectronics: STM32Cube Code Generator for FileX Pack</description>
      <exe>
        <command host="win">.config/gen_code.bat</command>
        <command host="linux">.config/gen_code.sh</command>
        <command host="mac">.config/gen_code.sh</command>
        <!-- $S = Device Family Pack base folder -->
        <argument>$S</argument>
        <!-- D = Device (Dname/Dvariant as configured by environment) -->
        <argument>$D</argument>
        <!-- Project path and project name (as configured by environment) -->
        <argument>$P</argument>
        <argument>#P</argument>
        <!-- #name of the gpdsc template contained in this PACK and aligned with GPDSC name-->
        <argument>STMicroelectronics.filex.gpdsc.hbs</argument>
        <!-- passing the generator name-->
        <argument>filex_mx2codegen</argument>
        <argument>$G</argument>
        <!-- Flag to indicate that this Generator is dry-run capable  -->
        <argument mode="dry-run">--dry-run</argument>
      </exe>
      <!-- workingDir></workingDir -->
      <!-- path is specified either absolute or relative to PDSC or GPDSC file. If not specified it is the project directory configured by the environment -->
      <gpdsc name="$P/STMicroelectronics.filex.gpdsc"/>
    </generator>
  </generators>
  <components>
