{{assign "filexFilter" (JSONparse '{"cgroup": "STM32CubeMX2 Config", "csub": "FileX"}')~}}
{{assign "filex_context" (@root.SWConfigurationAPI.getInstancesConfiguration @root.filexFilter)~}}
{{assign "filex_cxt" @root.filex_context.[0].settings.parameters~}}
{{assign "used_components_filex" (@root.SWProjectAPI.getUsedComponents "asObject" cgroup="FileX")~}}

{{#with filex_cxt.core.basic.filex_core~}}
{{#if (eq fx_standalone "No_OS")~}}
{{assign "No_OS_Mode" true~}}
{{/if~}}
{{#if (eq fx_standalone "FreeRTOS")~}}
{{assign "FreeRTOS_Mode" true~}}
{{/if~}}
{{/with}}

/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef __MX_FILEX_INTERFACES_H__
#define __MX_FILEX_INTERFACES_H__

#ifdef __cplusplus
extern "C" {
#endif

/* Includes ------------------------------------------------------------------*/
{{assign "need_hal_def_include" false~}}
{{assign "need_levelx_include" false~}}
{{assign "need_sd_polling_include" false~}}
{{assign "need_sd_dma_os_include" false~}}
{{assign "need_sd_dma_no_os_include" false~}}
{{assign "need_mmc_polling_include" false~}}
{{assign "need_mmc_dma_os_include" false~}}
{{assign "need_mmc_dma_no_os_include" false~}}
{{assign "need_nor_driver_include" false~}}
{{assign "need_nand_driver_include" false~}}
{{#with @root.filex_cxt~}}
{{#each interfaces as |iface i|~}}
{{#with iface.resources_allocation~}}
{{#if (or (eq hw_selection.selection "SDMMC1") (eq hw_selection.selection "SDMMC2"))~}}
{{assign "need_hal_def_include" true~}}
{{/if~}}
{{/with}}
{{#with iface.logical_config~}}
{{#if (eq interface_type "SD_ITF")~}}
{{#if (eq interface_mode "POLLING")~}}
{{assign "need_sd_polling_include" true~}}
{{/if~}}
{{#if (eq interface_mode "DMA_OS")~}}
{{assign "need_sd_dma_os_include" true~}}
{{/if~}}
{{#if (eq interface_mode "DMA_NO_OS")~}}
{{assign "need_sd_dma_no_os_include" true~}}
{{/if~}}
{{/if~}}
{{#if (eq interface_type "MMC_ITF")~}}
{{#if (eq interface_mode "POLLING")~}}
{{assign "need_mmc_polling_include" true~}}
{{/if~}}
{{#if (eq interface_mode "DMA_OS")~}}
{{assign "need_mmc_dma_os_include" true~}}
{{/if~}}
{{#if (eq interface_mode "DMA_NO_OS")~}}
{{assign "need_mmc_dma_no_os_include" true~}}
{{/if~}}
{{/if~}}
{{#if (eq interface_type "NOR_ITF")~}}
{{assign "need_levelx_include" true~}}
{{assign "need_nor_driver_include" true~}}
{{/if~}}
{{#if (eq interface_type "NAND_ITF")~}}
{{assign "need_levelx_include" true~}}
{{assign "need_nand_driver_include" true~}}
{{/if~}}
{{/with}}
{{/each}}
{{/with}}
{{#if need_hal_def_include}}
#include "mx_hal_def.h"
{{/if}}
{{#if need_sd_polling_include}}
#include "stm32_fx_sd_polling_driver.h"
{{/if}}
{{#if need_sd_dma_os_include}}
#include "stm32_fx_sd_dma_os_driver.h"
{{/if}}
{{#if need_sd_dma_no_os_include}}
#include "stm32_fx_sd_dma_no_os_driver.h"
{{/if}}
{{#if need_mmc_polling_include}}
#include "stm32_fx_mmc_polling_driver.h"
{{/if}}
{{#if need_mmc_dma_os_include}}
#include "stm32_fx_mmc_dma_os_driver.h"
{{/if}}
{{#if need_mmc_dma_no_os_include}}
#include "stm32_fx_mmc_dma_no_os_driver.h"
{{/if}}
{{#if need_levelx_include}}
