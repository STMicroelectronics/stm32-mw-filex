/**
  * @brief  Application FileX Initialization.
  * @param  None
  * @retval UINT: FX_SUCCESS on success, error code otherwise
  */
UINT app_filex_init(VOID)
{
{{#if generateInit}}
  UINT ret;
{{else}}
  {{#each filex_cxt.interfaces as |iface i|}}
    {{#with logical_config~}}
      {{#if applicative.filex_configure_task}}
  UINT ret;
      {{/if}}
    {{/with}}
  {{/each}}
{{/if}}
  {{#if generateInit}}
  /* Create the main FileX task if init code is generated */
  ret = xTaskCreate({{filex_cxt.core.applicative.filex_app_task_entry}}, "{{filex_cxt.core.applicative.filex_app_task_name}}", {{filex_cxt.core.applicative.filex_application_task_stack_size}}, NULL, {{filex_cxt.core.applicative.filex_application_task_priority}}, &main_task);
  if (ret != pdPASS)
  {
    return FX_PTR_ERROR;
  }
  {{/if}}
  {{#each filex_cxt.interfaces as |iface i|}}
    {{#with logical_config~}}
      {{#if applicative.filex_configure_task}}
  /* Create per-interface FileX task */
  ret = xTaskCreate({{applicative.filex_app_task_entry}}, "{{applicative.filex_app_task_name}}", {{applicative.filex_application_task_stack_size}}, NULL, {{applicative.filex_application_task_priority}}, &task_{{i}});

  if (ret != pdPASS)
  {
    return FX_PTR_ERROR;
  }
      {{/if}}
    {{/with}}
  {{/each}}
  fx_system_initialize();
  return FX_SUCCESS;
}

{{#if generateInit}}
VOID {{filex_cxt.core.applicative.filex_app_task_entry}}(VOID *args)
{
  {{#with filex_cxt~}}
    {{#each interfaces as |iface i|}}
      {{#with logical_config~}}
  {{#if (or applicative.filex_format_media applicative.filex_media_open)}}
  UINT status;
  VOID *fx_driver_{{i}}_info_ptr = mx_filex_driver_{{i}}_get_ctx();
      {{/if}}
  {{#if applicative.filex_format_media}}
  MX_FILEX_MEDIA_FORMAT_CONFIG *media_{{i}}_format_cfg;
  media_{{i}}_format_cfg = mx_filex_driver_{{i}}_get_media_format_config();

  status = fx_media_format(&fx_media_{{i}},
                           mx_filex_driver_{{i}},
                           fx_driver_{{i}}_info_ptr,
                           (VOID *)fx_media_{{i}}_buffer,
                           sizeof(fx_media_{{i}}_buffer),
                           volume_name_{{i}},
                           media_{{i}}_format_cfg->number_of_fats,
                           media_{{i}}_format_cfg->directory_entries,
                           media_{{i}}_format_cfg->hidden_sectors,
                           media_{{i}}_format_cfg->total_sectors,
                           media_{{i}}_format_cfg->bytes_per_sector,
                           media_{{i}}_format_cfg->sectors_per_cluster,
                           media_{{i}}_format_cfg->heads,
                           media_{{i}}_format_cfg->sectors_per_track);

  if (status != FX_SUCCESS)
  {
    while(1);
  }
  {{/if}}

  {{#if applicative.filex_media_open}}
  status = fx_media_open(&fx_media_{{i}}, volume_name_{{i}}, mx_filex_driver_{{i}}, fx_driver_{{i}}_info_ptr,
                         (VOID *)fx_media_{{i}}_buffer, sizeof(fx_media_{{i}}_buffer));

  if (status != FX_SUCCESS)
  {
    while(1);
  }
        {{/if}}
      {{/with}}
    {{/each}}
  {{/with}}
}

{{/if}}
