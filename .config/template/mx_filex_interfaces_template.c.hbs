/* get the internal object */
VOID *mx_filex_driver_{{i}}_get_ctx(VOID)
{
  {{#if (eq interface_mode "POLLING")}}
  mx_stm32_fx_sd_ctx_{{i}}.flags = FX_SD_FLAG_NONE;
  {{else if (or (eq interface_mode "DMA_OS") (eq interface_mode "DMA_NO_OS"))}}
    {{#if (and filex_sd_flag_cache_maintenance filex_sd_flag_scratch_buffer)}}
  mx_stm32_fx_sd_ctx_{{i}}.flags = FX_SD_FLAG_ALL;
    {{else if filex_sd_flag_cache_maintenance}}
  mx_stm32_fx_sd_ctx_{{i}}.flags = FX_SD_FLAG_CACHE_MAINTENANCE;
    {{else if filex_sd_flag_scratch_buffer}}
  mx_stm32_fx_sd_ctx_{{i}}.flags = FX_SD_FLAG_SCRATCH_BUFFER;
    {{else}}
  mx_stm32_fx_sd_ctx_{{i}}.flags = FX_SD_FLAG_NONE;
    {{/if}}
  {{else}}
  mx_stm32_fx_sd_ctx_{{i}}.flags = FX_SD_FLAG_NONE;
  {{/if}}
  mx_stm32_fx_sd_ctx_{{i}}.sd_max_timeout = {{applicative.more.filex_max_timeout}};
  {{#if (eq ../resources_allocation.sdmmc_ip_selection.selection "SDMMC1")}}
  mx_stm32_fx_sd_ctx_{{i}}.sd_handle = mx_sdmmc1_gethandle();
  {{/if}}
  {{#if (eq ../resources_allocation.sdmmc_ip_selection.selection "SDMMC2")}}
  mx_stm32_fx_sd_ctx_{{i}}.sd_handle = mx_sdmmc2_gethandle();
  {{/if}}
  return (VOID *)&mx_stm32_fx_sd_ctx_{{i}};
}
