{{#with @root.filex_cxt~}}
  {{#each interfaces as |iface i|}}
    {{#with iface.logical_config~}}
  {{#if applicative.filex_format_media}}
MX_FILEX_MEDIA_FORMAT_CONFIG *mx_filex_driver_{{i}}_get_media_format_config(VOID)
{
  {{#if (eq interface_type "NOR_ITF")}}
  media_{{i}}_format_cfg.bytes_per_sector    = LX_NOR_SECTOR_SIZE * sizeof(ULONG);
  {{else if (eq interface_type "NAND_ITF")}}
  media_{{i}}_format_cfg.bytes_per_sector    = LX_NAND_FLASH_0_SECTOR_SIZE;
  {{else}}
  media_{{i}}_format_cfg.bytes_per_sector    = {{applicative.more.filex_sector_size}};
  {{/if}}
  {{#if (eq interface_type "SD_ITF")}}
  hal_sd_card_info_t CardInfo;
  HAL_SD_GetCardInfo(mx_stm32_fx_sd_ctx_{{i}}.sd_handle, &CardInfo);
  media_{{i}}_format_cfg.total_sectors       = CardInfo.blk_nbr;
  {{else if (eq interface_type "MMC_ITF")}}
  hal_mmc_card_info_t CardInfo;
  HAL_MMC_GetCardInfo(mx_stm32_fx_mmc_ctx_{{i}}.mmc_handle, &CardInfo);
  media_{{i}}_format_cfg.total_sectors       = CardInfo.blk_nbr;
  {{else if (eq interface_type "NOR_ITF")}}
  media_{{i}}_format_cfg.total_sectors       = LX_NOR_FLASH_0_SIZE / LX_NOR_SECTOR_SIZE * sizeof(ULONG);
  {{else if (eq interface_type "NAND_ITF")}}
  media_{{i}}_format_cfg.total_sectors       = LX_NAND_FLASH_0_SIZE / LX_NAND_FLASH_0_SECTOR_SIZE;
  {{else}}
  media_{{i}}_format_cfg.total_sectors       = 512;
  {{/if}}
  media_{{i}}_format_cfg.directory_entries   = {{applicative.more.filex_directory_entries}}U;
  media_{{i}}_format_cfg.hidden_sectors      = {{applicative.more.filex_hidden_sectors}}U;
  media_{{i}}_format_cfg.heads               = {{applicative.more.filex_heads}}U;
  media_{{i}}_format_cfg.number_of_fats      = {{applicative.more.filex_number_of_fats}}U;
  media_{{i}}_format_cfg.sectors_per_cluster = {{applicative.more.filex_sectors_per_cluster}}UL;
  media_{{i}}_format_cfg.sectors_per_track   = {{applicative.more.filex_sectors_per_track}}U;
  return &media_{{i}}_format_cfg;
}
      {{/if}}
    {{/with}}
  {{/each}}
{{/with}}